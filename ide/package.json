{
  "name": "code-makers-ide",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "Editor local de código com Monaco, PowerShell e inteligência artificial opcional",
  "author": "Arthur",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "desktop:package": "npm run build && node scripts/package-desktop.mjs",
    "desktop:verify": "node scripts/verify-package.mjs",
    "build": "tsc && vite build",
    "release": "node scripts/release.mjs",
    "build:cloud": "tsc && vite build --mode cloud",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@supabase/supabase-js": "^2.117.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "framer-motion": "^11.0.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.323.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "parse5": "7.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "ws": "8.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.11.16",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "^10.4.17",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "24.1.3",
    "postcss": "^8.4.35",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
