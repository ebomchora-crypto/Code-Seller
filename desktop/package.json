{
  "name": "code-sellers-desktop",
  "private": true,
  "version": "1.1.0",
  "description": "Code Sellers para Windows — o app de verdade, com login pelo navegador.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --publish never",
    "release": "npm run dist:win && node scripts/copy-to-site.mjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.codesellers.desktop",
    "productName": "Code Sellers",
    "copyright": "Code Sellers",
    "asar": true,
    "publish": {
      "provider": "generic",
      "url": "https://codesellers.vercel.app/downloads"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "protocols": [
      {
        "name": "Code Sellers",
        "schemes": [
          "codesellers"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code Sellers",
      "include": "build/installer.nsh",
      "artifactName": "CodeSellers-Setup.exe",
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "CodeSellers-Portable.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
